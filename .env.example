# ===== Bot owner =====
OWNER_NUMBER=

# ===== Web pairing panel =====
# Port the panel listens on (Render sets this automatically).
# PORT=3000
# Secret used to sign the security-check captcha. Set your own random
# string in production (Render can auto-generate this — see render.yaml).
CAPTCHA_SECRET=change-me-to-a-random-string

# ===== Optional: Telegram (informational bot only, no pairing) =====
# TELEGRAM_TOKEN=
# URL of your deployed web panel, shown as a button in the Telegram menu
# PANEL_URL=https://your-app.onrender.com/panel/index.html

# ===== Optional: non-interactive pairing =====
# If your panel has no interactive console, set the number here.
# The bot will print the pairing code once on boot, then run normally.
# PAIR_NUMBER=2349127857212

# ===== Optional API keys =====
# OPENAI_API_KEY=
# WEATHER_API_KEY=
# REMOVEBG_API_KEY=
